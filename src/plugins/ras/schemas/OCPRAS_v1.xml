<?xml version="1.0" encoding="UTF-8"?>
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">

  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Capabilities.V1.xml">
    <edmx:Include Namespace="Org.OData.Capabilities.V1" Alias="Capabilities"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource"/>
    <edmx:Include Namespace="Resource.v1_0_0"/>
  </edmx:Reference>

  <edmx:DataServices>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="OCPRASService">
      <Annotation Term="Redfish.OwningEntity" String="OCPRASService"/>
      <Annotation Term="Redfish.Release" String="1.0"/>
    </Schema>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="OCPRASService.v1_0_0">
      <Annotation Term="Redfish.OwningEntity" String="OCPRASService"/>
      <Annotation Term="Redfish.Release" String="1.0"/>

      <!-- RASService Resource -->
      <EntityType Name="RASService" BaseType="Resource.v1_0_0.Resource" Abstract="false">
        <Annotation Term="OData.Description" String="RAS Service for error coordination and management."/>
        <Annotation Term="OData.LongDescription" String="This resource represents a Reliability, Availability, and Serviceability coordination service for a Manager."/>
        
        <Property Name="ServiceEnabled" Type="Edm.Boolean">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
          <Annotation Term="OData.Description" String="Indicates whether this service is enabled."/>
        </Property>
        
        <Property Name="Status" Type="Resource.Status" Nullable="false">
          <Annotation Term="OData.Description" String="The status of this service."/>
        </Property>
        
        <Property Name="Governance" Type="OCPRASService.v1_0_0.Governance">
          <Annotation Term="OData.Description" String="Governance metadata for this pre-standard service."/>
        </Property>
        
        <NavigationProperty Name="LogService" Type="LogService.LogService">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="Link to the RAS LogService."/>
        </NavigationProperty>
        
        <NavigationProperty Name="Endpoints" Type="Collection(Endpoint.Endpoint)">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="RAS Endpoints collection."/>
        </NavigationProperty>
        
        <NavigationProperty Name="Initiators" Type="Collection(Resource.Item)">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="RAS Initiators collection."/>
        </NavigationProperty>
        
        <Property Name="Actions" Type="OCPRASService.v1_0_0.Actions" Nullable="false">
          <Annotation Term="OData.Description" String="Available actions for this resource."/>
        </Property>
      </EntityType>

      <!-- Governance Complex Type -->
      <ComplexType Name="Governance">
        <Annotation Term="OData.AdditionalProperties" Bool="false"/>
        <Annotation Term="OData.Description" String="Governance metadata for pre-standard features."/>
        
        <Property Name="OwningWorkstream" Type="Edm.String">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The workstream responsible for this specification."/>
        </Property>
        
        <Property Name="GoverningSpecification" Type="Edm.String">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="The specification that governs this implementation."/>
        </Property>
        
        <Property Name="SpecificationVersion" Type="Edm.String">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="Version of the governing specification."/>
        </Property>
        
        <Property Name="SpecificationURI" Type="Edm.String">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="URI to the governing specification."/>
        </Property>
        
        <Property Name="StandardizationIntent" Type="Edm.String">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="Intended standardization body."/>
        </Property>
        
        <Property Name="TargetNamespace" Type="Edm.String">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="Expected namespace after standardization."/>
        </Property>
        
        <Property Name="ImplementationStatus" Type="OCPRASService.v1_0_0.ImplementationStatus">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="Maturity level of this implementation."/>
        </Property>
        
        <Property Name="ContractStability" Type="OCPRASService.v1_0_0.ContractStability">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="Stability level of the API contract."/>
        </Property>
      </ComplexType>

      <!-- Actions Complex Type -->
      <ComplexType Name="Actions">
        <Annotation Term="OData.AdditionalProperties" Bool="false"/>
        <Property Name="Oem" Type="OCPRASService.v1_0_0.OemActions" Nullable="false"/>
      </ComplexType>

      <ComplexType Name="OemActions">
        <Annotation Term="OData.AdditionalProperties" Bool="true"/>
      </ComplexType>

      <!-- SubmitCPAD Action -->
      <Action Name="SubmitCPAD" IsBound="true">
        <Annotation Term="OData.Description" String="Submit a Common Platform Error Record - Abstracted Data."/>
        <Parameter Name="RASService" Type="OCPRASService.v1_0_0.Actions" Nullable="false"/>
        <Parameter Name="CPADData" Type="Edm.String" Nullable="false">
          <Annotation Term="OData.Description" String="The CPAD record data."/>
        </Parameter>
        <Parameter Name="Severity" Type="Edm.String">
          <Annotation Term="OData.Description" String="Override severity classification."/>
        </Parameter>
      </Action>

      <!-- Enumerations -->
      <EnumType Name="ImplementationStatus">
        <Member Name="Prototype">
          <Annotation Term="OData.Description" String="Prototype implementation."/>
        </Member>
        <Member Name="Development">
          <Annotation Term="OData.Description" String="Development implementation."/>
        </Member>
        <Member Name="Production">
          <Annotation Term="OData.Description" String="Production-ready implementation."/>
        </Member>
        <Member Name="Deprecated">
          <Annotation Term="OData.Description" String="Deprecated implementation."/>
        </Member>
      </EnumType>

      <EnumType Name="ContractStability">
        <Member Name="Experimental">
          <Annotation Term="OData.Description" String="Experimental - breaking changes may occur."/>
        </Member>
        <Member Name="Stable">
          <Annotation Term="OData.Description" String="Stable - backward compatibility maintained."/>
        </Member>
        <Member Name="Frozen">
          <Annotation Term="OData.Description" String="Frozen - no changes allowed."/>
        </Member>
        <Member Name="Deprecated">
          <Annotation Term="OData.Description" String="Deprecated - do not use for new development."/>
        </Member>
      </EnumType>

      <!-- Manager Extension -->
      <ComplexType Name="ManagerExtension">
        <Annotation Term="OData.AdditionalProperties" Bool="false"/>
        <Annotation Term="OData.Description" String="OCPRASService extension for Manager resource."/>
        
        <NavigationProperty Name="RASService" Type="OCPRASService.v1_0_0.RASService">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
          <Annotation Term="OData.Description" String="Link to the RAS Service resource."/>
        </NavigationProperty>
      </ComplexType>

    </Schema>

  </edmx:DataServices>
</edmx:Edmx>
